{
    "repositories": [
        {
            "type": "vcs",
            "url":  "https://github.com/tjdraper/bypass-readonly"
        }
    ],
    "name": "rxante/php-app-bootstrap",
    "description": "RxAnte's PHP App Boostrap",
    "type": "library",
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "RxAnte Web Services"
        }
    ],
    "require": {
        "php": "^8.2",
        "composer/class-map-generator": "^1.6",
        "crell/tukio": "^2.0",
        "mnapoli/silly": "^1.9",
        "php-di/php-di": "^7.0",
        "psr/container": "^2.0",
        "psr/event-dispatcher": "^1.0",
        "psr/log": "^1.0 || ^2.0 || ^3.0",
        "rxante/coding-standards": "^3",
        "slim/csrf": "^1.5",
        "slim/psr7": "^1.7",
        "slim/slim": "^4.14"
    },
    "require-dev": {
        "filp/whoops": "^2.16",
        "mockery/mockery": "^1.6",
        "pestphp/pest": "^3.5",
        "zoltanka/bypass-readonly": "dev-bugfix"
    },
    "autoload": {
        "psr-4": {
            "RxAnte\\AppBootstrap\\": "src",
            "RxAnte\\Tests\\": "tests"
        }
    },
    "config": {
        "bin-compat": "full",
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "pestphp/pest-plugin": true
        }
    }
}
