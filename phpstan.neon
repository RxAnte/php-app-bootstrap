parameters:
    paths:
        - src
    ignoreErrors:
        - "#^Access to an undefined property Pest\\\\Mixins\\\\Expectation\\<string\\|null\\>\\:\\:\\$not\\.$#"
    excludePaths:
        analyseAndScan:
            - *.test.php
            - *Test.php

includes:
    - vendor/rxante/coding-standards/phpstan.neon
